mv urls.txt urls.txt.bak && mongosh --quiet tor_scraper --eval 'db.pages.find({url: {$type: "string"}}, {_id: 0, url: 1}).forEach(d => print(d.url))' | sort -u > urls.txt
----
mongodump -d tor_scraper -c pages --out /tmp
mongorestore -d tor_scraper -c pages /tmp/tor_scraper/pages.bson
